{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recordlog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Cloudflare Workers Builds runs `npx wrangler deploy` with no build step of
  // its own, so the PWA build is declared here rather than in a deploy script.
  // Both `wrangler deploy` and `wrangler dev` now produce dist/ before they
  // need it, locally and in CI alike.
  "build": { "command": "npm run build" },

  // The Worker owns /api/* ; everything else is served from the built PWA in dist/.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // Free tier: 100k reads/day, 5M rows written/month.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recordlog",
      "database_id": "775c978c-377b-4b0c-b74d-d98dda78877e",
      "migrations_dir": "migrations",
    },
  ],

  // Optional. R2 keeps the original audio so it can be played back from any
  // device; without it transcripts work exactly the same and audio stays on
  // the device that recorded it. R2 has to be switched on for the account in
  // the dashboard first (R2 > Enable), so it is left out by default rather
  // than blocking the deploy. To turn it on:
  //
  //     npx wrangler r2 bucket create recordlog-audio
  //
  // then uncomment the line below and redeploy. The app notices the binding
  // by itself and enables the "音声をサーバーに保管" setting.
  //
  // "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "recordlog-audio" }],

  // Workers AI: Whisper for transcription, Llama for the daily stack.
  "ai": { "binding": "AI" },

  // 18:00 UTC == 03:00 Asia/Tokyo. One run per day, exactly as specified.
  "triggers": {
    "crons": ["0 18 * * *"],
  },

  "vars": {
    "APP_TIMEZONE": "Asia/Tokyo",
    "ASR_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "KEEP_AUDIO_DAYS": "14",
  },
}

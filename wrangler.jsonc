{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recordlog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Cloudflare Workers Builds runs `npx wrangler deploy` with no build step of
  // its own, so the PWA build is declared here rather than in a deploy script.
  // Both `wrangler deploy` and `wrangler dev` now produce dist/ before they
  // need it, locally and in CI alike.
  "build": { "command": "npm run build" },

  // The Worker owns /api/* ; everything else is served from the built PWA in dist/.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // Free tier: 100k reads/day, 5M rows written/month.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recordlog",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],

  // Free tier: 10 GB storage, zero egress fees. Holds the original audio.
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "recordlog-audio",
    },
  ],

  // Workers AI: Whisper for transcription, Llama for the daily stack.
  "ai": { "binding": "AI" },

  // 18:00 UTC == 03:00 Asia/Tokyo. One run per day, exactly as specified.
  "triggers": {
    "crons": ["0 18 * * *"],
  },

  "vars": {
    "APP_TIMEZONE": "Asia/Tokyo",
    "ASR_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "KEEP_AUDIO_DAYS": "14",
  },
}
